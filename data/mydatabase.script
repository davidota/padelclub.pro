CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE SEQUENCE PUBLIC.IDGENERATOR AS INTEGER START WITH 1000 INCREMENT BY 50
CREATE MEMORY TABLE PUBLIC.TORNEOS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,NOMBRE VARCHAR(255))
ALTER TABLE PUBLIC.TORNEOS ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.APPLICATION_USER(VERSION INTEGER NOT NULL,ID BIGINT NOT NULL PRIMARY KEY,APELLIDO VARCHAR(255),HASHED_PASSWORD VARCHAR(255),NAME VARCHAR(255),PROFILE_PICTURE BLOB(1G),USERNAME VARCHAR(255),UNIQUE(USERNAME))
CREATE MEMORY TABLE PUBLIC.ENFRENTAMIENTOS(EQUIPO1_ID BIGINT NOT NULL,EQUIPO2_ID BIGINT NOT NULL,ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,TORNEO_ID BIGINT NOT NULL,RESULTADO VARCHAR(255))
ALTER TABLE PUBLIC.ENFRENTAMIENTOS ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.EQUIPO(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,PARTICIPANTE1_ID BIGINT NOT NULL,PARTICIPANTE2_ID BIGINT NOT NULL,NOMBRE_EQUIPO VARCHAR(255),CONSTRAINT FKA4D3HCDVPFXHW15RCKI9SLOEI FOREIGN KEY(PARTICIPANTE1_ID) REFERENCES PUBLIC.APPLICATION_USER(ID),CONSTRAINT FK6NN3CS1UTE019SI4H9G8G34HF FOREIGN KEY(PARTICIPANTE2_ID) REFERENCES PUBLIC.APPLICATION_USER(ID))
ALTER TABLE PUBLIC.EQUIPO ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.SERVICE_PRINCIPAL(EXPIRATION_DATE TIMESTAMP,APP_ID VARCHAR(255) NOT NULL PRIMARY KEY,COMMENTS VARCHAR(255),ENTORNO VARCHAR(255),SECRET VARCHAR(255),TENANT_ID VARCHAR(255),USO VARCHAR(255),CHECK((PUBLIC.SERVICE_PRINCIPAL.ENTORNO) IN (('DEV'),('UAT'),('PRO'))))
CREATE MEMORY TABLE PUBLIC.TORNEO(JUEGOS_POR_ENFRENTAMIENTO INTEGER,NUMERO_DE_VUELTAS INTEGER NOT NULL,NUMERO_ENFRENTAMIENTOS INTEGER,NUMERO_ENFRENTAMIENTOS_SIMULTANEOS INTEGER,ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,ESTADO VARCHAR(255),NOMBRE VARCHAR(255),TIPO VARCHAR(255),CHECK((PUBLIC.TORNEO.ESTADO) IN (('ABIERTO'),('CERRADO'),('FINALIZADO'))),CHECK((PUBLIC.TORNEO.TIPO) IN (('ROUND_ROBIN'),('ELIMINACION_DIRECTA'),('GRUPOS'))))
ALTER TABLE PUBLIC.TORNEO ALTER COLUMN ID RESTART WITH 3
CREATE MEMORY TABLE PUBLIC.TORNEO_JUGADORES(JUGADORES_ID BIGINT NOT NULL,TORNEO_ID BIGINT NOT NULL,CONSTRAINT FKYS3RROCYCVM38N3W6UU1V1HU FOREIGN KEY(JUGADORES_ID) REFERENCES PUBLIC.APPLICATION_USER(ID),CONSTRAINT FKREAS3R4O93CMTRIF5G673YRY3 FOREIGN KEY(TORNEO_ID) REFERENCES PUBLIC.TORNEO(ID))
CREATE MEMORY TABLE PUBLIC.USER_ROLES(USER_ID BIGINT NOT NULL,ROLES VARCHAR(255),CHECK((PUBLIC.USER_ROLES.ROLES) IN (('USER'),('ADMIN'),('PLAYER'))),CONSTRAINT FKQ0H6VPF3CRN504YYEP1HDV0VC FOREIGN KEY(USER_ID) REFERENCES PUBLIC.APPLICATION_USER(ID))
ALTER TABLE PUBLIC.ENFRENTAMIENTOS ADD CONSTRAINT FKJ6J1LKBEJUOKVRBMVYA6KJ9NL FOREIGN KEY(EQUIPO1_ID) REFERENCES PUBLIC.EQUIPO(ID)
ALTER TABLE PUBLIC.ENFRENTAMIENTOS ADD CONSTRAINT FKK8VHERCVRIQJXH720GA99EUV5 FOREIGN KEY(EQUIPO2_ID) REFERENCES PUBLIC.EQUIPO(ID)
ALTER TABLE PUBLIC.ENFRENTAMIENTOS ADD CONSTRAINT FKR7L4D3XYP68DNIT09W883928R FOREIGN KEY(TORNEO_ID) REFERENCES PUBLIC.TORNEO(ID)
