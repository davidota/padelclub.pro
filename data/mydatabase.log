create table service_principal (expiration_date timestamp(6), app_id varchar(255) not null, comments varchar(255), entorno varchar(255) check (entorno in ('DEV','UAT','PRO')), secret varchar(255), tenant_id varchar(255), uso varchar(255), primary key (app_id))
create table torneo (juegos_por_enfrentamiento integer not null, numero_enfrentamientos integer not null, id bigint generated by default as identity (start with 1), nombre varchar(255), tipo varchar(255) check (tipo in ('ROUNDROBIN','TIEBREAK','CLASICO')), primary key (id))
create table torneo_jugadores (jugadores_id bigint not null, torneo_id bigint not null)
create table user_roles (user_id bigint not null, roles varchar(255) check (roles in ('USER','ADMIN','PLAYER')))
