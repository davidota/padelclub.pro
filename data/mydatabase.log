SET SCHEMA PUBLIC
drop table if exists enfrentamientos cascade 
drop table if exists equipo cascade 
drop table if exists service_principal cascade 
drop table if exists torneo cascade 
drop table if exists torneo_jugadores cascade 
drop table if exists user_roles cascade 
drop sequence idgenerator if exists
create sequence idgenerator start with 1000 increment by 50
create table application_user (version integer not null, id bigint not null, apellido varchar(255), hashed_password varchar(255), name varchar(255), profile_picture blob, username varchar(255) unique, primary key (id))
create table enfrentamientos (equipo1_id bigint not null, equipo2_id bigint not null, id bigint generated by default as identity (start with 1), torneo_id bigint not null, resultado varchar(255), primary key (id))
create table equipo (id bigint generated by default as identity (start with 1), participante1_id bigint not null, participante2_id bigint not null, nombre_equipo varchar(255), primary key (id))
create table service_principal (expiration_date timestamp(6), app_id varchar(255) not null, comments varchar(255), entorno varchar(255) check (entorno in ('DEV','UAT','PRO')), secret varchar(255), tenant_id varchar(255), uso varchar(255), primary key (app_id))
create table torneo (juegos_por_enfrentamiento integer, numero_de_vueltas integer not null, numero_enfrentamientos integer, numero_enfrentamientos_simultaneos integer, id bigint generated by default as identity (start with 1), estado varchar(255) check (estado in ('ABIERTO','CERRADO','FINALIZADO')), nombre varchar(255), tipo varchar(255) check (tipo in ('ROUND_ROBIN','ELIMINACION_DIRECTA','GRUPOS')), primary key (id))
create table torneo_jugadores (jugadores_id bigint not null, torneo_id bigint not null)
create table user_roles (user_id bigint not null, roles varchar(255) check (roles in ('USER','ADMIN','PLAYER')))
alter table enfrentamientos add constraint FKj6j1lkbejuokvrbmvya6kj9nl foreign key (equipo1_id) references equipo
